[Unit]
Wants=containerd.service

[Service]
Environment="KUBELET_CONFIG_DIR_ARGS=--config-dir=/etc/kubernetes/kubelet.conf.d"
ExecStart=
ExecStart=/usr/bin/kubelet $KUBELET_KUBECONFIG_ARGS $KUBELET_CONFIG_ARGS $KUBELET_KUBEADM_ARGS $KUBELET_EXTRA_ARGS $KUBELET_CONFIG_DIR_ARGS
{% if kube_reserved_cgroups is defined %}
Slice={{ kube_reserved_cgroups }}
{% endif %}
OOMScoreAdjust=-999
